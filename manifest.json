{
  "manifest_version": 3,
  "name": "Hide Image In Comments",
  "version": "1.0",
  "description" : "Блокировака изображений в комментариях YouTube роликов",
  "permissions": [ "declarativeNetRequest" ],
  "content_scripts": [
    {
      "matches": [ "https://www.youtube.com/watch*", "https://www.youtube.com/shorts*" ],
      "css": [ "hide.css" ],
      "run_at": "document_start"
    }
  ],

  "action":{
    "default_icon":{
      "16":"icons/icon16.png",
      "32":"icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title" :"Заблокировать изображения"
  },
  "icons":{
    "16":"icons/icon16.png",
    "32":"icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "BlockRequestToGIFAndImageInComment",
        "enabled": true,
        "path" : "rules.json"
      }
    ]
  }
}